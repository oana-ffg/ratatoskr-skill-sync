{
  "name": "ratatoskr-skill-sync-desktop",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "npm run check && vite build",
    "tauri": "tauri",
    "prepare:helper": "node scripts/prepare-helper.mjs",
    "format": "prettier --write src scripts tests e2e \"*.json\" \"*.ts\"",
    "format:check": "prettier --check src scripts tests e2e \"*.json\" \"*.ts\"",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && npm run prepare:fixtures && vitest run",
    "test:screenshots": "npm run prepare:fixtures && playwright test",
    "prepare:fixtures": "node scripts/prepare-fixtures.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2",
    "diff": "^9.0.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^4.1.12"
  }
}
