{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ratatoskr Skill Sync",
  "version": "0.2.10",
  "identifier": "io.github.oana-ffg.ratatoskr-skill-sync",
  "build": {
    "beforeDevCommand": "npm run prepare:helper -- --debug && npm run dev",
    "beforeBuildCommand": "npm run prepare:helper && npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ratatoskr Skill Sync",
        "width": 1180,
        "height": 850,
        "minWidth": 560,
        "minHeight": 600,
        "theme": "Dark",
        "backgroundColor": "#101510"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ratatoskr"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzOTg3OUVEQUZDMjFFMzQKUldRMEhzS3Y3WG1ZUTJacjhoeDNTb21rSWNYWGg0SGRFclRiUi8wZS9NQTJORXk3eUhpRGYzNmIK",
      "endpoints": [
        "https://github.com/oana-ffg/ratatoskr-skill-sync/releases/latest/download/latest.json"
      ]
    }
  }
}
